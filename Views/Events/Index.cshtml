@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Events";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        @TempData["Error"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Events</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Event</a>
</div>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Event Name</th>
            <th>Event Date</th>
            <th>Description</th>
            <th>Venue</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        @item.Description
                    }
                    else
                    {
                        <span class="text-muted" style="font-size:0.85rem;">No description</span>
                    }
                </td>
                <td>
                    @if (item.Venue != null)
                    {
                        @item.Venue.VenueName
                    }
                    else
                    {
                        <span class="text-muted" style="font-size:0.85rem;">Not assigned</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No events found. <a asp-action="Create">Create a new event.</a>
    </div>
}